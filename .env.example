# Sao chép thành apps/studio/.env (pnpm dev tự làm việc này và sinh khóa ngẫu nhiên).

# Cơ sở dữ liệu: "file:./data/studio.db" (SQLite, local) hoặc "postgres://user:pass@host:5432/db"
HOSSO_DATABASE_URL=file:./data/studio.db

# Khóa bí mật của Payload (chuỗi ngẫu nhiên dài)
HOSSO_SECRET=

# URL công khai của site (không có dấu / ở cuối)
HOSSO_PUBLIC_URL=http://localhost:3000

# Khóa mã hóa khóa API/bí mật lưu trong DB (32 byte, hex hoặc base64)
HOSSO_ENCRYPTION_KEY=

# Tài khoản quản trị đầu tiên (chỉ dùng khi DB chưa có người dùng)
HOSSO_ADMIN_EMAIL=admin@example.com
HOSSO_ADMIN_PASSWORD=

# Nạp dữ liệu mẫu khi DB trống ("false" để tắt)
HOSSO_SEED=true
