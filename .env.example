# Sao chép thành apps/studio/.env (pnpm dev tự làm việc này và sinh khóa ngẫu nhiên).

# Cơ sở dữ liệu: "file:./data/studio.db" (SQLite, local) hoặc "postgres://user:pass@host:5432/db"
HOSSO_DATABASE_URL=file:./data/studio.db

# Khóa bí mật của Payload (chuỗi ngẫu nhiên dài)
HOSSO_SECRET=

# URL công khai của site (không có dấu / ở cuối)
HOSSO_PUBLIC_URL=http://localhost:3000

# Khóa mã hóa khóa API/bí mật lưu trong DB (32 byte, hex hoặc base64)
HOSSO_ENCRYPTION_KEY=

# Tài khoản quản trị đầu tiên (chỉ dùng khi DB chưa có người dùng)
HOSSO_ADMIN_EMAIL=admin@example.com
HOSSO_ADMIN_PASSWORD=

# Nạp dữ liệu mẫu khi DB trống ("false" để tắt)
HOSSO_SEED=true

# --- Plugin WIM (tùy chọn). Nếu đặt ở đây thì được ưu tiên hơn giá trị nhập trong admin. ---
HOSSO_WIM_API_URL=
HOSSO_WIM_API_KEY=
HOSSO_WIM_WEBHOOK_SECRET=
# Thời gian chờ WIM (ms) và TTL cache (giây)
# HOSSO_WIM_TIMEOUT_MS=5000
# HOSSO_WIM_CACHE_TTL=30

# Thư mục lưu media tải lên (mặc định ./media trong apps/studio)
# HOSSO_MEDIA_DIR=

# --- Docker compose ---
POSTGRES_PASSWORD=
# HOSSO_PORT=3000

# --- Email thông báo (bình luận, biểu mẫu); bỏ trống thì email chỉ ghi ra nhật ký ---
# HOSSO_SMTP_URL=smtp://user:pass@smtp.example.com:587
# HOSSO_MAIL_FROM=no-reply@example.com

# --- Cache, sao lưu, cập nhật ---
# HOSSO_CACHE_TTL=60            # giây CDN/reverse proxy được cache trang công khai (0 = tắt)
# HOSSO_BACKUP_DIR=./backups    # nơi lưu gói sao lưu (pnpm studio:backup)
# HOSSO_BACKUP_KEEP=14          # số bản sao lưu giữ lại
# HOSSO_TEMPLATES_DIR=          # thư mục mẫu site (*.hosso-site.zip); mặc định seed/sites
# HOSSO_UPDATE_URL=             # JSON {version,url} hoặc GitHub releases/latest để báo có bản mới trong admin
