{
  "name": "@hosso/studio",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm generate:importmap",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "prebuild": "pnpm generate:importmap",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "studio:export": "cross-env HOSSO_SCRIPT=1 NODE_OPTIONS=--no-deprecation payload run scripts/studio-export.ts",
    "studio:backup": "cross-env HOSSO_SCRIPT=1 NODE_OPTIONS=--no-deprecation payload run scripts/studio-backup.ts",
    "studio:import": "cross-env HOSSO_SCRIPT=1 NODE_OPTIONS=--no-deprecation payload run scripts/studio-import.ts",
    "studio:import-wordpress": "cross-env HOSSO_SCRIPT=1 NODE_OPTIONS=--no-deprecation payload run scripts/wordpress-import.ts --",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hosso/plugin-accounts": "workspace:*",
    "@hosso/plugin-affiliate": "workspace:*",
    "@hosso/plugin-analytics": "workspace:*",
    "@hosso/plugin-notify": "workspace:*",
    "@hosso/plugin-payment": "workspace:*",
    "@hosso/plugin-promotions": "workspace:*",
    "@hosso/plugin-reports": "workspace:*",
    "@hosso/plugin-shipping": "workspace:*",
    "@hosso/plugin-shop": "workspace:*",
    "@hosso/studio-blocks": "workspace:*",
    "@hosso/theme-alt": "workspace:*",
    "@hosso/theme-auto": "workspace:*",
    "@hosso/theme-default": "workspace:*",
    "@hosso/theme-shop": "workspace:*",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/db-sqlite": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@puckeditor/core": "0.23.0",
    "cross-env": "10.1.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "graphql": "16.14.2",
    "next": "16.4.2",
    "node-html-parser": "9.0.4",
    "nodemailer": "^10.1.2",
    "payload": "3.91.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.15"
  }
}
