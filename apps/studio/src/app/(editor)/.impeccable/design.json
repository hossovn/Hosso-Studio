  "narrative": {
    "northStar": "The Working Canvas",
    "overview": "This is an extracted description of Studio's editor, scoped to this directory. The canvas carries the website; compact white controls surround it. The owner supplied Wix references and authorized implementation decisions directly. The familiar editor structure is retained with Hosso's green action color.\n\nThe interface supports repeated, precise work: choose a section or page template, edit content, preview devices and save through the existing publication flow. This record concerns editor controls. Website theme tokens, template artwork, and the Thanh Cuong storefront identity belong to their own surfaces.",
    "keyCharacteristics": [
      "Compact toolbars and a line-icon navigation rail.",
      "White controls separated by quiet gray rules.",
      "Visual libraries with real, settled content previews.",
      "Deliberate panel opening and persistent editing state.",
      "Green actions and selected states, with responsive tool access."
    ],
    "rules": [
      {
        "name": "The Separate Surfaces Rule",
        "body": "Website brand changes preview inside the canvas; they do not recolor editor controls.",
        "section": "colors"
      },
      {
        "name": "The Interface Type Rule",
        "body": "Keep control typography stable when the customer's website font changes.",
        "section": "typography"
      },
      {
        "name": "The Deliberate Panel Rule",
        "body": "Open tools with a click. Moving the pointer away does not close the panel; the active tool, close control or Escape closes it.",
        "section": "layout"
      },
      {
        "name": "The Overlay Depth Rule",
        "body": "Use panel elevation to distinguish temporary tools from the persistent workspace.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep website content visually separate from editor controls.",
      "Do use real template previews and catalog photos when available.",
      "Do expose loading, empty, error and disabled states for data-dependent tools.",
      "Do retain pending brand edits when switching tools.",
      "Do preserve keyboard focus indicators and reduced-motion behavior."
    ],
    "donts": [
      "Don't reopen the old hover-to-open panel behavior.",
      "Don't start website animations inside template thumbnails.",
      "Don't treat an empty manual product selection as the full catalog.",
      "Don't apply a customer's storefront colors to Studio's editor chrome.",
      "Don't present a draft brand save as publication of the website."
    ]
  }
}
