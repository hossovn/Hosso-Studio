# Biến môi trường cho stack Portainer. Điền vào mục "Environment variables" của stack, KHÔNG commit file đã điền.
HOSSO_IMAGE=ghcr.io/ten-tai-khoan/hosso-tcap:1

# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
HOSSO_SECRET=
HOSSO_ENCRYPTION_KEY=

HOSSO_PUBLIC_URL=https://ten-mien-cua-ban.vn
HOSSO_PORT=3000

# Tài khoản admin tạo ở lần chạy đầu (đổi mật khẩu sau khi đăng nhập)
HOSSO_ADMIN_EMAIL=
HOSSO_ADMIN_PASSWORD=
HOSSO_SEED=false

# Giấy phép plugin thương mại (cấp bằng hosso-plugins/tools/issue-license.mjs)
HOSSO_LICENSE_KEY=

# WIM
HOSSO_WIM_API_URL=https://tcap-wim.hosso.vn
HOSSO_WIM_API_KEY=
HOSSO_WIM_WEBHOOK_SECRET=

# Email thông báo (tùy chọn)
HOSSO_SMTP_URL=
HOSSO_MAIL_FROM=
