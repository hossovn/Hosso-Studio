# Biến môi trường cho stack Portainer của Web Test.
# Điền vào mục "Environment variables" của Stack trên Portainer, KHÔNG commit file đã điền.
HOSSO_IMAGE=ghcr.io/hossovn/hosso-tcap:latest

# Khóa cơ sở dữ liệu và bảo mật
# Sinh chuỗi hex ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
HOSSO_SECRET=
HOSSO_ENCRYPTION_KEY=

# URL công khai của Web Test (ví dụ: https://test.thanhcuongauto.com hoặc IP/cổng)
HOSSO_PUBLIC_URL=https://test.thanhcuongauto.com
HOSSO_PORT=3001

# Tài khoản admin tạo lần đầu
HOSSO_ADMIN_EMAIL=admin@test.local
HOSSO_ADMIN_PASSWORD=
HOSSO_SEED=false

# Giấy phép plugin thương mại (nếu có)
HOSSO_LICENSE_KEY=

# Khóa kết nối Bán chéo với Web chính TCAP (Hosso -> Hosso)
HOSSO_CROSS_SELL_TCAP_TOKEN=

# Khóa kết nối Bán chéo với WordPress WooCommerce
HOSSO_CROSS_SELL_WP_KEY=
HOSSO_CROSS_SELL_WP_SECRET=
