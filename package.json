{
  "name": "hosso-studio",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.15",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/ensure-env.mjs && pnpm --filter @hosso/studio dev",
    "dev:test": "node scripts/dev-test.mjs",
    "build": "pnpm --filter @hosso/studio build",
    "start": "pnpm --filter @hosso/studio start",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "pnpm -r typecheck",
    "check:manifests": "node scripts/check-manifests.mjs",
    "test:kiln": "node --experimental-strip-types scripts/test-kiln.mjs",
    "test:canvas": "node --experimental-strip-types scripts/test-canvas.mjs",
    "test:studio-layout": "node --experimental-strip-types scripts/test-studio-layout.mjs",
    "test:site-releases": "node scripts/test-site-releases.mjs",
    "test:studio-browser": "node scripts/test-studio-browser.mjs",
    "test:studio-workbench": "node scripts/test-studio-workbench.mjs",
    "test:editor-workspace": "node scripts/test-editor-workspace.mjs",
    "test:editor-productivity": "node --experimental-strip-types scripts/test-editor-productivity.mjs",
    "test:editor-canvas-upgrades": "node --experimental-strip-types scripts/test-editor-canvas-upgrades.mjs",
    "test:editor-canvas-upgrades-browser": "node scripts/test-editor-canvas-upgrades-browser.mjs",
    "test:editor-productivity-browser": "node scripts/test-editor-productivity-browser.mjs",
    "test:form-delivery": "tsx scripts/test-form-delivery.mts",
    "test:editor-preview": "node --experimental-strip-types scripts/test-editor-preview.mjs",
    "test:site-package": "node scripts/test-site-package.mjs",
    "test:admin-views": "node scripts/test-admin-views.mjs",
    "test:job-stats-migration": "node scripts/test-job-stats-migration.mjs",
    "test:cross-sell-migration": "node scripts/test-cross-sell-migration.mjs",
    "test:product-pool": "node scripts/test-product-pool.mjs",
    "test:order-reliability": "node scripts/review-product-pool.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:order-flow": "node scripts/check-order-flow.mjs",
    "mock:wim": "pnpm --filter @hosso/mock-wim start",
    "studio:export": "pnpm --filter @hosso/studio studio:export",
    "studio:import": "pnpm --filter @hosso/studio studio:import",
    "studio:backup": "pnpm --filter @hosso/studio studio:backup",
    "studio:update": "node scripts/studio-update.mjs",
    "studio:update:check": "node scripts/studio-update.mjs --check",
    "studio:update:auto": "node scripts/studio-update.mjs --auto",
    "migrate": "pnpm --filter @hosso/studio migrate",
    "studio:import-wordpress": "pnpm --filter @hosso/studio studio:import-wordpress"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "sharp": "-"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "happy-dom": "^20.14.6",
    "tsx": "4.23.15"
  }
}
