    "./admin-list": "./src/admin-list.tsx"
  },
  "scripts": { "typecheck": "tsc -p ." },
  "dependencies": { "@hosso/studio-blocks": "workspace:*" },
  "peerDependencies": { "react": "19.3.1" },
  "devDependencies": { "@payloadcms/ui": "3.91.0", "@types/react": "19.3.0", "payload": "3.91.0", "react": "19.3.1", "typescript": "5.9.3" }
