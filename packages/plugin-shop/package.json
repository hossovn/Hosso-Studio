{
  "name": "@hosso/plugin-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plugin cửa hàng cho Hosso Studio: sản phẩm, danh mục, tồn kho, giỏ hàng, đặt hàng (COD/chuyển khoản), quản lý đơn và nhập/xuất CSV. Chạy độc lập, không cần WIM.",
