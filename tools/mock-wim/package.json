{
  "name": "@hosso/mock-wim",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Mock Hosso WIM built from openapi.yaml (NestJS 11). The real WIM server later replaces the mock, keeping controllers/DTOs and swapping the data layer. / Mock Hosso WIM dựng từ openapi.yaml.",
  "scripts": {
    "generate:api": "openapi-typescript openapi.yaml -o src/api/schema.d.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "pnpm build && node dist/main.js",
    "mock": "node dist/cli.js",
    "test:contract": "pnpm build && node dist/contract-test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
